# ReturnLoop configuration. Copy to .env (never commit .env).
# The app runs fully in demo/simulation mode with every Meta field left blank.

APP_ENV=demo
DATABASE_URL=sqlite:///./data/returnloop.db

# simulation (default) or live. Live also needs ALL Meta fields below.
WHATSAPP_MODE=simulation

# Official Meta WhatsApp Business Platform (Cloud API) - fill in later, server-side only
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=

# Planning assumptions for cost estimates (editable in Settings).
# NOT a verified Meta/provider tariff - check the current rate card before live use.
MESSAGE_RATE_INR=1.20
MESSAGE_RATE_EFFECTIVE_DATE=
GST_PERCENT=18
